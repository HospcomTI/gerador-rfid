# Organizacao (4 digitos, usada no prefixo do EPC)
ORG_NAME=0000

# Planilha de entrada e de saida
XLSX_IN_PATH=./dados/dados.xlsx
XLSX_OUT_PATH=./dados/saida.xlsx

# Abas lidas do XLSX_IN_PATH
# 1: itens selecionados (coluna A = x/s/1/sim)
# 2: fonte da validade por (Cod.Item + N Lote)
XLSX_SHEET_1=Planilha1
XLSX_SHEET_2=Planilha2

# Banco local (bun:sqlite)
SQLITE_PATH=./.sqlite3

# Impressora de etiquetas: ZEBRA (ZPL) ou SATO (SBPL)
IMPRESSORA_TIPO=ZEBRA
IMPRESSORA_IP=192.168.0.100

# Resolucao da impressora em dpi (203 ou 305)
DPI=203
